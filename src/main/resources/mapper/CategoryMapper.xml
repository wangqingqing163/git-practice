<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.bookstore.mapper.CategoryMapper">

    <select id="findAll" resultType="Category">
        SELECT * FROM category
    </select>

    <select id="findById" resultType="Category">
        SELECT * FROM category WHERE id = #{id}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO category(name, description, icon, sort_order, parent_id)
        VALUES(#{name}, #{description}, #{icon}, #{sortOrder}, #{parentId})
    </insert>

    <update id="update">
        UPDATE category
        SET name = #{name},
            description = #{description},
            icon = #{icon},
            sort_order = #{sortOrder},
            parent_id = #{parentId}
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM category WHERE id = #{id}
    </delete>

    <delete id="deleteAll">
        DELETE FROM category
    </delete>

</mapper>